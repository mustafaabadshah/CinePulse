# ResearchRadar Configuration Environment Variables

# Application Environment (development | production | test)
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Security & Admin Access
# Generate a strong key for production (e.g. openssl rand -hex 32)
ADMIN_API_KEY=rr_admin_secret_dev_key_change_me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration
# SQLite (Lightweight development profile):
DATABASE_URL=sqlite:///./data/researchradar.db
# PostgreSQL (Full Docker profile):
# DATABASE_URL=postgresql://radar_user:radar_password@localhost:5432/researchradar

# Meilisearch Configuration
MEILI_HTTP_ADDR=http://127.0.0.1:7700
MEILI_MASTER_KEY=masterKey_ResearchRadar_Dev_2026_Secure
MEILI_ENV=development

# Search Evaluation & Ingestion
DEFAULT_SEARCH_LIMIT=20
MAX_SEARCH_LIMIT=100
MAX_PAGE_SIZE=50
INGESTION_BATCH_SIZE=100

# Media CSV Ingestion & Synchronization
CSV_DATA_DIR=data
CSV_ENRICHMENT_FILE=prod_enrichment.csv
CSV_EPISODES_FILE=episodes_prod.csv
INDEX_TASK_TIMEOUT_SEC=60.0
INDEX_BATCH_SIZE=500
